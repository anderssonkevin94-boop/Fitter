  m_Script: {fileID: 11500000, guid: 8413a4830b951416c99a8b2a1b098555, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ravenholm.Presentation::Ravenholm.Presentation.SiteInspectable
  title: Mine
  description: 'Dig your own Mine into the cliff face: stand on the dirt at the cliff''s
    edge and hold Dig. Blocks are half a level tall, so you are two blocks tall.
    Left and right walk along the cliff; down on the stick digs underfoot and up
    overhead. Down reaches the next layer (new ores, harder rock); along the cliff
    stays in a layer. A shaft two or more blocks deep gets a ladder: climb it with
    up and down.'
  plannedPhase: 
  siteId: site.mine
