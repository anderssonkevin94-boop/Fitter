  m_Name: 
  m_EditorClassIdentifier: Ravenholm.Presentation::Ravenholm.Presentation.SiteInspectable
  title: Mine
  description: 'The Mine is dug straight into the ground. Each level is one miner
    deep and shows the layer it was dug in; the levels below show darker. Miners
    clear a level block by block; then you choose to continue this layer or dig into
    the next. Down is progress: Dig Deeper sinks the shaft through the next layer,
    three levels deep. Left is staying in a layer: Continue Here digs that level''s
    tunnel left, under the Forest. Climb down the ladder to walk the levels yourself.'
  plannedPhase: 
  siteId: site.mine
